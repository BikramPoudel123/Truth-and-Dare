FROM node:20-alpine
WORKDIR /app
COPY server-package.json package.json ./
RUN npm install --omit=dev && npm cache clean --force
COPY server.js .
RUN mkdir -p uploads
EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:5000/health || exit 1
CMD ["node", "server.js"]
